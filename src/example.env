# PayTR credentials — found on the Merchant Panel BİLGİ / INFORMATION page.
# Copy this file to .env and fill in real values. NEVER commit the real .env.

# Merchant no (Mağaza no)
PAYTR_MERCHANT_ID=XXXXXX

# Merchant password (mağaza parolası) — keep secret
PAYTR_MERCHANT_KEY=YYYYYYYYYYYYYY

# Merchant secret key (mağaza gizli anahtarı) — keep secret
PAYTR_MERCHANT_SALT=ZZZZZZZZZZZZZZ

# 1 = test mode (use PayTR test cards, no real charge), 0 = live
PAYTR_TEST_MODE=1
